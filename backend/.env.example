# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/hrms_db
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/hrms_db?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Email Configuration (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password
EMAIL_FROM=noreply@hrms.com
APP_NAME=HRMS

# File Upload Configuration
MAX_FILE_SIZE=5242880
# 5MB in bytes (5 * 1024 * 1024)

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
# 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100
# Maximum requests per window

# Auth Rate Limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
# 15 minutes in milliseconds
AUTH_RATE_LIMIT_MAX_REQUESTS=5
# Maximum login attempts per window

# Session Configuration (if using sessions)
SESSION_SECRET=your_session_secret_key_change_this

# Encryption Key (for sensitive data)
ENCRYPTION_KEY=your_encryption_key_32_characters

# Cloudinary Configuration (optional - for file uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AWS S3 Configuration (optional - alternative for file uploads)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your_bucket_name


# Logging
LOG_LEVEL=info
# Options: error, warn, info, debug

# Timezone
TZ=Asia/Kolkata
# Or use UTC

# API Documentation
API_DOCS_URL=/api/docs

# Default Admin Credentials (for seeding)
DEFAULT_ADMIN_EMAIL=admin@hrms.com
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_ADMIN_EMPLOYEE_ID=EMP001